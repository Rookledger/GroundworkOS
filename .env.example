# =============================================================================
# GroundworkOS — environment variables
# =============================================================================
# This file documents every environment variable the app uses. Cloudflare
# Workers have no single .env file at runtime, so this is reference only —
# copy the values you need into the real places they're actually read from:
#
# * Non-secret Worker vars → artifacts/api-server/wrangler.jsonc's `vars`
#   block (committed) or its per-environment `env.*` overrides.
# * Worker secrets → `wrangler secret put <NAME>` (from artifacts/api-server),
#   never committed.
# * Local dev → artifacts/api-server/.dev.vars (gitignored; `wrangler dev`
#   reads it automatically).
# * Frontend build-time variables → Cloudflare Pages build environment
#   variables for the artifacts/groundworkos project (Vite inlines these into
#   the built bundle at build time; the Worker never sees them).
#
# See README.md's "Environment Variables" section and DEPLOYMENT.md for the
# full walkthrough.
#
# Each variable below is tagged:
#   [core]     the Worker returns a 500 "Server misconfigured" without these
#              (see artifacts/api-server/src/lib/validateEnv.ts)
#   [build]    frontend build-time variable (Cloudflare Pages build env, not
#              a Worker var/secret)
#   [optional] only if you use that feature
# =============================================================================

# -----------------------------------------------------------------------------
# App settings — [core] (Worker var, e.g. wrangler.jsonc `vars.APP_URL`)
# -----------------------------------------------------------------------------
# The frontend's origin, e.g. https://app.yourdomain.com. Used for CORS, the
# Content-Security-Policy, and Better Auth's baseURL/trustedOrigins.
APP_URL=https://app.yourdomain.com

# -----------------------------------------------------------------------------
# Authentication (Better Auth) — [core] (Worker secret)
# -----------------------------------------------------------------------------
# Better Auth runs on the Worker itself (same-origin, mounted at
# /api/auth/*) — there's no separate third-party auth account or frontend
# publishable key to configure. Sign-in is email + password only; no Google
# or other social/OAuth sign-in provider is configured.
#
# Used for session token signing/encryption — must be at least 32 characters
# (e.g. `openssl rand -base64 32`). Set with:
#   pnpm exec wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=CHANGE_ME_32_CHARS_MINIMUM

# --- Invite-only sign-up ---
# GroundworkOS has no public sign-up endpoint at all
# (emailAndPassword.disableSignUp in artifacts/api-server/src/lib/betterAuth.ts).
# Every account is created by an admin inviting an email from
# Settings → Users, which the invitee accepts at /accept-invite?token=...
# The very first account (on a brand-new, admin-less deployment) has to be
# seeded directly in D1 — see DEPLOYMENT.md's "First login and admin user"
# step.

# [optional] Worker var. Comma-separated email domains an admin is allowed to
# invite, e.g. "yourcompany.co.uk". Leave unset to allow inviting any domain.
# SIGNUP_ALLOWED_EMAIL_DOMAINS=yourcompany.co.uk

# [optional] Worker var. Locks the first-admin bootstrap flow
# (GET /api/admin/bootstrap-status, POST /api/admin/bootstrap) to one email
# address — see README.md's "User Roles" section. Left unset, bootstrap is
# open to whichever signed-in, non-admin user reaches Settings → Users first
# on an admin-less workspace.
# BOOTSTRAP_ADMIN_EMAIL=owner@yourcompany.co.uk

# -----------------------------------------------------------------------------
# Frontend build-time variables — [build] (Cloudflare Pages build env)
# -----------------------------------------------------------------------------
# Required at build time by the frontend's Vite config. Use "/" when the app
# is served at the domain root.
BASE_PATH=/

# -----------------------------------------------------------------------------
# Email (Resend) — [optional] (Worker secret)
# -----------------------------------------------------------------------------
# Only needed if you send emails (invitations, quotes, invoices) from the
# app. Set with: pnpm exec wrangler secret put RESEND_API_KEY
# RESEND_API_KEY=re_xxx

# -----------------------------------------------------------------------------
# Accounting integrations — [optional]
# -----------------------------------------------------------------------------
# Each provider is independent — only set the ones this client actually
# uses. CLIENT_ID/REDIRECT_URI are Worker vars (wrangler.jsonc); CLIENT_SECRET
# is a Worker secret (wrangler secret put). Every REDIRECT_URI must point at
# your app's domain, e.g. https://app.yourdomain.com/api/xero/callback (the
# same domain the /api/* Workers Route is bound to, not the Worker's own
# *.workers.dev domain), and must be registered in that provider's developer
# dashboard.

# Xero
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://app.yourdomain.com/api/xero/callback

# QuickBooks Online
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REDIRECT_URI=https://app.yourdomain.com/api/quickbooks/callback

# Sage Accounting
# SAGE_CLIENT_ID=
# SAGE_CLIENT_SECRET=
# SAGE_REDIRECT_URI=https://app.yourdomain.com/api/sage/callback

# FreeAgent
# FREEAGENT_CLIENT_ID=
# FREEAGENT_CLIENT_SECRET=
# FREEAGENT_REDIRECT_URI=https://app.yourdomain.com/api/freeagent/callback
