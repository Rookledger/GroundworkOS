{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": ["src", "worker-configuration.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    // Not yet ported to D1/Workers (still references a module-level `db`
    // singleton and Node's `process.env`) - dev-only seed script, not part
    // of the deployed Worker bundle. Tracked as follow-up work.
    "src/seed.ts"
  ],
  "references": [
    { "path": "../../lib/shared-role" },
    { "path": "../../lib/db" },
    { "path": "../../lib/api-zod" }
  ]
}
