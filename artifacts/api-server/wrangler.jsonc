{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundworkos-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-25",
  // nodejs_compat is required by a few dependencies that assume a Node-like
  // global environment even though they run fine on V8 isolates (Better
  // Auth, Resend). It does NOT bring back
  // `fs`, raw TCP/TLS sockets, or child_process - those stay unavailable on
  // Workers, and nothing in this codebase uses them any more (see the R2
  // object storage backend replacing the old S3 client, and the removal of
  // the STATIC_DIR / express.static single-service hosting path now that
  // the frontend deploys separately to Cloudflare Pages).
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },

  // ── D1 (replaces the Railway Postgres database) ──────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      // Confirmed directly in the Cloudflare dashboard (Storage & databases
      // -> D1 SQLite Database) on 2026-08-28: this is the only D1 database
      // that exists in the Ktrgcrms@outlook... account. A prior commit
      // pointed this at a "ktr-groundworks" database/id that do not exist
      // in that account - see DEPLOYMENT.md Step 1.
      "database_name": "groundworkos",
      "database_id": "7a982d10-b66d-4500-af43-380b9b6ad23c",
      "migrations_dir": "../../lib/db/migrations",
    },
  ],

  // ── R2 (replaces the S3-compatible object storage backend) ───────────────
  // Holds RAMS, insurance certs, certifications, permits, plant compliance
  // docs, and site photos - the same content the old S3StorageBackend wrote
  // under uploads/. See src/lib/objectStorage.ts.
  "r2_buckets": [
    {
      "binding": "DOCS_BUCKET",
      // Reused the existing "ktr-groundworks-docs" bucket rather than
      // creating a duplicate. R2 isn't enabled for API access on this
      // account yet (dashboard-only), so this name is unverified via API -
      // confirm it exists in the dashboard before deploying.
      "bucket_name": "ktr-groundworks-docs",
    },
  ],

  // ── KV (replaces express-rate-limit's in-memory store, and the in-memory
  // OAuth CSRF state Map in accountingOAuthFactory.ts) ──────────────────────
  // A Worker has no long-lived, single-instance process the way the old
  // Railway container did - state kept in a module-level Map is not safe to
  // rely on across requests/isolates. Both rate-limit counters and OAuth
  // state tokens are short-lived, so KV (rather than D1) is the right store:
  // see src/lib/rateLimits.ts and src/routes/accountingOAuthFactory.ts.
  "kv_namespaces": [
    {
      "binding": "KV",
      // Confirmed directly in the Cloudflare dashboard (Storage & databases
      // -> Workers KV) on 2026-08-28: this is the only KV namespace that
      // exists in the Ktrgcrms@outlook... account. A prior commit pointed
      // this at a "ktr-groundworks-kv" namespace/id that do not exist in
      // that account.
      "id": "8f3ba7f136024cc0a699f2da0853d367",
    },
  ],

  // ── Secrets (set with `wrangler secret put <NAME>`, never committed) ─────
  // BETTER_AUTH_SECRET, RESEND_API_KEY, XERO_CLIENT_SECRET,
  // QUICKBOOKS_CLIENT_SECRET, SAGE_CLIENT_SECRET, FREEAGENT_CLIENT_SECRET.

  // ── Plain vars (non-secret configuration) ─────────────────────────────────
  "vars": {
    // Frontend origin - the "groundworkos" Worker's own workers.dev domain,
    // since there's no custom domain/zone on this account yet (see the
    // frontend's wrangler.jsonc: it proxies /api/* to this Worker via a
    // service binding rather than a Workers Route, which requires a zone).
    // Used for CORS, Better Auth's baseURL/trustedOrigins, and OAuth
    // redirect building. The Cloudflare Git-connected Build for this Worker
    // deploys with no `--env` flag, so it reads these top-level `vars`, not
    // the unused `env.production` block below - update this value (and
    // that block, for consistency) together if the frontend ever moves to
    // a custom domain.
    "APP_URL": "https://groundworkos.ktrgcrms.workers.dev",
    // Restricts the first-admin bootstrap flow (DEPLOYMENT.md Step 7) to
    // this address so it can't be claimed by whoever accepts an invite
    // first. Double-check this is the right inbox before inviting yourself
    // as the first admin - change it in the Cloudflare dashboard (Settings
    // -> Variables) or here if not.
    "BOOTSTRAP_ADMIN_EMAIL": "lauhonyanhk1@gmail.com",
    "SIGNUP_ALLOWED_EMAIL_DOMAINS": "",
    "XERO_CLIENT_ID": "",
    "XERO_REDIRECT_URI": "",
    "QUICKBOOKS_CLIENT_ID": "",
    "QUICKBOOKS_REDIRECT_URI": "",
    "SAGE_CLIENT_ID": "",
    "SAGE_REDIRECT_URI": "",
    "FREEAGENT_CLIENT_ID": "",
    "FREEAGENT_REDIRECT_URI": "",
  },

  "env": {
    "production": {
      "vars": {
        "APP_URL": "https://groundworkos.ktrgcrms.workers.dev",
      },
    },
  },
}
