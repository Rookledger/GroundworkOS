{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundworkos-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-25",
  // nodejs_compat is required by a few dependencies that assume a Node-like
  // global environment even though they run fine on V8 isolates (Better
  // Auth, Resend). It does NOT bring back
  // `fs`, raw TCP/TLS sockets, or child_process - those stay unavailable on
  // Workers, and nothing in this codebase uses them any more (see the R2
  // object storage backend replacing the old S3 client, and the removal of
  // the STATIC_DIR / express.static single-service hosting path now that
  // the frontend deploys separately to Cloudflare Pages).
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },

  // ── Multi-client deployment ────────────────────────────────────────────
  // GroundworkOS is single-tenant per deployment: each client gets their own
  // Worker, D1 database, KV namespace and R2 bucket, and those can live on
  // entirely different Cloudflare accounts. Rather than forking the repo per
  // client, each client is a named Wrangler environment below (`env.<slug>`),
  // deployed with `wrangler deploy --env <slug>`. Wrangler resolves
  // `account_id` from either the `account_id` field in that env block or
  // (if omitted) the `CLOUDFLARE_ACCOUNT_ID` env var / whichever account the
  // `CLOUDFLARE_API_TOKEN` in use belongs to - see .github/workflows/deploy.yml,
  // which supplies both per-client as GitHub Environment secrets.
  //
  // The top-level fields below (`vars`, `d1_databases`, `kv_namespaces`,
  // `r2_buckets`) are ONLY used by `wrangler dev` when no `--env` is passed
  // (local development) - they intentionally mirror the first onboarded
  // client ("ktr") so local dev works out of the box. Every real deploy goes
  // through an `env.<slug>` block instead; do not deploy without `--env`.
  //
  // To onboard a new client:
  //   1. On the client's own Cloudflare account, run:
  //        wrangler d1 create <slug>
  //        wrangler kv namespace create KV
  //        wrangler r2 bucket create <slug>-docs
  //   2. Add an `env.<slug>` block below (copy "ktr" and update the ids,
  //      account_id, and APP_URL).
  //   3. Add matching env/kv/r2/service blocks to
  //      ../groundworkos/wrangler.jsonc's `env.<slug>`.
  //   4. Create a GitHub Environment named `<slug>` (Settings → Environments)
  //      holding that client's `CLOUDFLARE_API_TOKEN` (and `CLOUDFLARE_ACCOUNT_ID`
  //      if you didn't set `account_id` below) as environment secrets.
  //   5. Run `wrangler secret put BETTER_AUTH_SECRET --env <slug>` (and any
  //      other secrets from Step 3 of DEPLOYMENT.md) once, authenticated
  //      against the client's account.
  //   6. Trigger the "Deploy" workflow with `client: <slug>`.
  // See DEPLOYMENT.md's "Multiple clients, multiple Cloudflare accounts"
  // section for the full walkthrough.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "groundworkos",
      "database_id": "8b2c3479-5fe1-41e2-9d14-875de78dab6f",
      "migrations_dir": "../../lib/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOCS_BUCKET",
      "bucket_name": "ktr-groundworks-docs-eu",
      "jurisdiction": "eu",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "8f3ba7f136024cc0a699f2da0853d367",
    },
  ],
  "vars": {
    "APP_URL": "https://groundworkos.ktrgcrms.workers.dev",
    "BOOTSTRAP_ADMIN_EMAIL": "lauhonyanhk1@gmail.com",
    "SIGNUP_ALLOWED_EMAIL_DOMAINS": "",
    "XERO_CLIENT_ID": "3ED400645EEF4FDCA8BBE3372C671F14",
    "XERO_REDIRECT_URI": "https://groundworkos.ktrgcrms.workers.dev/api/xero/callback",
    "QUICKBOOKS_CLIENT_ID": "",
    "QUICKBOOKS_REDIRECT_URI": "",
    "SAGE_CLIENT_ID": "",
    "SAGE_REDIRECT_URI": "",
    "FREEAGENT_CLIENT_ID": "",
    "FREEAGENT_REDIRECT_URI": "",
  },

  // ── Secrets (set with `wrangler secret put <NAME> --env <slug>`, never
  // committed) ── BETTER_AUTH_SECRET, RESEND_API_KEY, XERO_CLIENT_SECRET,
  // QUICKBOOKS_CLIENT_SECRET, SAGE_CLIENT_SECRET, FREEAGENT_CLIENT_SECRET.

  "env": {
    // First onboarded client ("Ktrgcrms@outlook..." Cloudflare account).
    // Kept name-less (no `account_id`) so it deploys wherever the CI
    // token/local `wrangler login` session is authenticated, matching the
    // account these ids were provisioned on.
    "ktr": {
      "name": "groundworkos-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "groundworkos",
          "database_id": "8b2c3479-5fe1-41e2-9d14-875de78dab6f",
          "migrations_dir": "../../lib/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DOCS_BUCKET",
          "bucket_name": "ktr-groundworks-docs-eu",
          "jurisdiction": "eu",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "8f3ba7f136024cc0a699f2da0853d367",
        },
      ],
      "vars": {
        "APP_URL": "https://groundworkos.ktrgcrms.workers.dev",
        "BOOTSTRAP_ADMIN_EMAIL": "lauhonyanhk1@gmail.com",
        "SIGNUP_ALLOWED_EMAIL_DOMAINS": "",
        "XERO_CLIENT_ID": "3ED400645EEF4FDCA8BBE3372C671F14",
        "XERO_REDIRECT_URI": "https://groundworkos.ktrgcrms.workers.dev/api/xero/callback",
        "QUICKBOOKS_CLIENT_ID": "",
        "QUICKBOOKS_REDIRECT_URI": "",
        "SAGE_CLIENT_ID": "",
        "SAGE_REDIRECT_URI": "",
        "FREEAGENT_CLIENT_ID": "",
        "FREEAGENT_REDIRECT_URI": "",
      },
    },

    // Template for the next client - copy this block, rename the key, and
    // fill in the ids from Step 1 of the onboarding checklist above. Leave
    // `account_id` set explicitly here (rather than relying on whichever
    // account the CI token happens to belong to) so a misconfigured token
    // fails loudly instead of silently deploying to the wrong account.
    // "acme": {
    //   "name": "groundworkos-api-acme",
    //   "account_id": "<acme's Cloudflare account id>",
    //   // Database name kept as "groundworkos" for every client (each is on
    //   // its own Cloudflare account, so there's no name collision) - the
    //   // deploy workflow's `wrangler d1 migrations apply groundworkos
    //   // --env <slug>` step assumes this name.
    //   "d1_databases": [
    //     { "binding": "DB", "database_name": "groundworkos", "database_id": "<...>", "migrations_dir": "../../lib/db/migrations" },
    //   ],
    //   "r2_buckets": [
    //     { "binding": "DOCS_BUCKET", "bucket_name": "acme-docs" },
    //   ],
    //   "kv_namespaces": [
    //     { "binding": "KV", "id": "<...>" },
    //   ],
    //   "vars": {
    //     "APP_URL": "https://app.acme.example.com",
    //     "BOOTSTRAP_ADMIN_EMAIL": "admin@acme.example.com",
    //     "SIGNUP_ALLOWED_EMAIL_DOMAINS": "",
    //     "XERO_CLIENT_ID": "", "XERO_REDIRECT_URI": "",
    //     "QUICKBOOKS_CLIENT_ID": "", "QUICKBOOKS_REDIRECT_URI": "",
    //     "SAGE_CLIENT_ID": "", "SAGE_REDIRECT_URI": "",
    //     "FREEAGENT_CLIENT_ID": "", "FREEAGENT_REDIRECT_URI": "",
    //   },
    // },
  },
}
