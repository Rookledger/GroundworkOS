{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundworkos",
  "compatibility_date": "2025-08-25",
  // Frontend is a static Vite SPA build (see vite.config.ts outDir) -
  // served as Cloudflare Workers static assets. A thin Worker script
  // (worker/index.js) also sits in front of the assets: it only runs for
  // requests that don't match a static file, and forwards `/api/*` to the
  // separately-deployed `groundworkos-api` Worker via the service binding
  // below (see that file's comment for why - no custom domain/zone means
  // no Workers Route), falling back to index.html for everything else
  // (SPA client-side routes) the way `not_found_handling` used to.
  "main": "worker/index.js",
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    // Cloudflare's built-in SPA fallback: any request that isn't a literal
    // static asset gets index.html back with a real 200, no redirect. See
    // worker/index.js's comment for why this replaced a hand-rolled
    // "/index.html" fetch that was silently redirecting every client-side
    // route (e.g. /accept-invite, /setup, /portal/:token) to "/".
    "not_found_handling": "single-page-application",
    // Without this, Cloudflare's assets layer serves the SPA shell
    // directly for ANY unmatched path - including /api/* - without ever
    // invoking worker/index.js. That silently broke every API call
    // (e.g. "Connect to Xero" 404ing into the app's own not-found page
    // instead of reaching groundworkos-api): the request never got as far
    // as this Worker's `url.pathname.startsWith("/api/")` forwarding
    // check. Listing /api/* here forces the Worker script to run first
    // for those paths so the service-binding forward actually happens;
    // everything else still falls through to the SPA shell as before.
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "API",
      // Must match the service's own `name` in
      // artifacts/api-server/wrangler.jsonc.
      "service": "groundworkos-api"
    }
  ],

  // ── Multi-client deployment ────────────────────────────────────────────
  // Same per-client pattern as artifacts/api-server/wrangler.jsonc: each
  // client is a named environment below, deployed with
  // `wrangler deploy --env <slug>`, and its `services[0].service` must
  // match that client's API Worker `name` (the `env.<slug>.name` set in
  // api-server's wrangler.jsonc). The top-level config above is local-dev
  // only (`wrangler dev` with no `--env`) and mirrors "ktr".
  "env": {
    "ktr": {
      "name": "groundworkos",
      "services": [
        { "binding": "API", "service": "groundworkos-api" }
      ],
    },

    // Template for the next client - copy this block, rename the key, and
    // point `service` at that client's API Worker name.
    // "acme": {
    //   "name": "groundworkos-acme",
    //   "account_id": "<acme's Cloudflare account id>",
    //   "services": [
    //     { "binding": "API", "service": "groundworkos-api-acme" }
    //   ],
    // },
  },
}
